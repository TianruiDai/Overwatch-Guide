# Local app (Node.js 22.13+). Copy as .env and uncomment the settings you need.
PORT=8787

# Custom OpenAI-compatible vision model, including a local vision server.
# OW_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# OW_MODEL_ID=your-vision-model
# OW_MODEL_API_KEY=

# BK927/overwatch-aio Streamable HTTP endpoint.
# OW_MCP_URL=http://127.0.0.1:8765/mcp
# OW_MCP_TOKEN=

# Existing recorded files named ABC123.mp4, ABC123.webm or ABC123.mov.
# OW_CAPTURE_DIR=D:/Overwatch/Recordings
