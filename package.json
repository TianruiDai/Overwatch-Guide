{
  "name": "overwatch-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/local.mjs",
    "dev": "node --env-file-if-exists=.env server/local.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/skills-manifest.mjs && node scripts/build.mjs",
    "skills:manifest": "node scripts/skills-manifest.mjs",
    "knowledge:pack": "node scripts/knowledge-pack.mjs",
    "knowledge:seed": "node scripts/knowledge-seed.mjs",
    "knowledge:version": "node scripts/generate-version-cards.mjs && node scripts/knowledge-seed.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "fflate": "0.8.2"
  }
}
